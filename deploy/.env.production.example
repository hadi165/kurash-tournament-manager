# Production environment for the Kurash Competition Manager.
#
# Copy to /var/www/kurash/shared/.env, replace every REPLACE_ME, then:
#   chmod 600 .env
#
# This file is read by the running application and by the queue worker. It is
# the only place real credentials live, and it is never committed.

APP_NAME="Kurash Competition Manager"
APP_ENV=production

# php artisan key:generate writes this. Changing it later makes every encrypted
# scoreboard API key unreadable.
APP_KEY=

# Never true on a live server: it renders stack traces, environment variables
# and database credentials to whoever triggered the error.
APP_DEBUG=false

APP_URL=https://REPLACE_ME
APP_LOCALE=en

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kurash
DB_USERNAME=kurash
DB_PASSWORD=REPLACE_ME

# ---------------------------------------------------------------------------
# Queue, cache and sessions
#
# `database` works and needs nothing extra. Redis is installed by the
# provisioning steps; switch these three to `redis` when you want the speed.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Sessions only travel over HTTPS once the certificate is issued.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# ---------------------------------------------------------------------------
# Logging
#
# `daily` keeps 14 files instead of one that grows without limit. `error` keeps
# a competition day's request noise out of the log so real failures stand out.
# ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Scoreboards
#
# There is deliberately no default secret. Unset, the webhook returns 503 to
# every request rather than falling back to a placeholder that is published in
# the source — which is exactly how the original system was left open.
#
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# ---------------------------------------------------------------------------
SCOREBOARD_DRIVER=http
SCOREBOARD_TIMEOUT=5
SCOREBOARD_WEBHOOK_SECRET=REPLACE_ME
SCOREBOARD_WEBHOOK_HEADER=X-Scoreboard-Token

# ---------------------------------------------------------------------------
# Mail — only needed for password resets.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@REPLACE_ME"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
