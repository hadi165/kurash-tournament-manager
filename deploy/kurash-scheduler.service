# Laravel's scheduler, run by a systemd timer rather than crontab.
#
# It drives the nightly backup and the failed-job pruning declared in
# routes/console.php. A timer is preferred over cron here because its failures
# land in the journal beside everything else, instead of in mail nobody reads.
#
#   sudo cp deploy/kurash-scheduler.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kurash-scheduler.timer
#
# Confirm it is armed with: systemctl list-timers kurash-scheduler.timer

[Unit]
Description=Kurash scheduled tasks
After=network.target mariadb.service

[Service]
Type=oneshot
User=kurash
Group=kurash
WorkingDirectory=/var/www/kurash/current
ExecStart=/usr/bin/php artisan schedule:run

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kurash-scheduler

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
