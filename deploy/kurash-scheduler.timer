[Unit]
Description=Run the Kurash scheduler every minute
Requires=kurash-scheduler.service

[Timer]
# Laravel expects to be invoked once a minute; it decides internally which of
# its tasks are actually due.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s
Unit=kurash-scheduler.service

[Install]
WantedBy=timers.target
