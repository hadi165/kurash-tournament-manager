APP_NAME="Kurash Competition Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# The application credential. It may reach the application database and
# nothing else — in particular it must have NO privileges on the test
# database, and it must not be root.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=youruser_kurash
DB_USERNAME=youruser_kurashapp
DB_PASSWORD=

# ── Two credentials, two databases ───────────────────────────────────────────
#
# The test suite drops and re-migrates its database on every single test. It
# must therefore be physically unable to reach the application's. Sharing one
# credential across both — which this project did until 2026-08-26 — means the
# only thing standing between a mistyped database name and the competition
# data is that nobody mistyped it. That has now failed three times.
#
# Grant it once, as an administrator (this project never runs these for you):
#
#   CREATE DATABASE IF NOT EXISTS youruser_kurash_test;
#   CREATE USER 'youruser_kurashtest'@'%' IDENTIFIED BY '<a different password>';
#   GRANT ALL PRIVILEGES ON youruser_kurash_test.* TO 'youruser_kurashtest'@'%';
#   REVOKE ALL PRIVILEGES ON youruser_kurash.* FROM 'youruser_kurashtest'@'%';
#   REVOKE ALL PRIVILEGES ON youruser_kurash_test.* FROM 'youruser_kurashapp'@'%';
#   FLUSH PRIVILEGES;
#
# Then point phpunit.xml at the test credential:
#
#   <env name="DB_DATABASE" value="youruser_kurash_test"/>
#   <env name="DB_USERNAME" value="youruser_kurashtest"/>
#   <env name="DB_PASSWORD" value="..."/>
#
# After that a test run aimed at the application database fails to connect
# instead of succeeding and emptying it. App\Support\DatabaseGuard refuses it
# first either way, but the grant is the layer that does not depend on this
# application's code being correct.
#
# Never put a root credential in either place.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Scoreboards. driver: http | fake | null
SCOREBOARD_DRIVER=http
SCOREBOARD_TIMEOUT=5
# Required. The result webhook refuses every request until this is set.
SCOREBOARD_WEBHOOK_SECRET=
SCOREBOARD_WEBHOOK_HEADER=X-Scoreboard-Token
