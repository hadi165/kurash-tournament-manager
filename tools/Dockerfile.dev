# Dev-only image: the host PHP has pdo_mysql but no pdo_sqlite, and the stock
# php:8.3-cli image has pdo_sqlite but no pdo_mysql. The legacy import needs
# both at once — it reads the old SQLite file and writes to MariaDB.
FROM php:8.3-cli

RUN docker-php-ext-install pdo_mysql bcmath \
    && apt-get update \
    && apt-get install -y --no-install-recommends libzip-dev libicu-dev unzip \
    && docker-php-ext-install zip intl \
    && rm -rf /var/lib/apt/lists/*
